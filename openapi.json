{
  "openapi": "3.1.0",
  "info": {
    "title": "Quran Page Splitter API",
    "version": "1.0.0",
    "description": ""
  },
  "paths": {
    "/api/suras": {
      "get": {
        "operationId": "api_views_suras_list_suras",
        "summary": "List Suras",
        "parameters": [
          {
            "in": "query",
            "name": "qiraa",
            "schema": {
              "default": "hafs",
              "title": "Qiraa",
              "type": "string"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SuraOut"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "description": "List canonical suras with aya counts for the given qiraa (default: hafs).",
        "tags": ["suras"]
      }
    },
    "/api/mushafs": {
      "get": {
        "operationId": "api_views_mushafs_list_mushafs",
        "summary": "List Mushafs",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MushafOut"
