                    "type": "string"
                  },
                  "ignore_x": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Ignore X"
                  },
                  "ignore_y": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Ignore Y"
                  },
                  "ignore_w": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Ignore W"
                  },
                  "ignore_h": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Ignore H"
                  }
                },
                "required": ["image"],
                "title": "MultiPartBodyParams",
                "type": "object"
              }
            }
          },
          "required": true
        }
      }
    },
