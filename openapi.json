          },
          "start_sura": {
            "title": "Start Sura",
            "type": "integer"
          },
          "start_aya": {
            "title": "Start Aya",
            "type": "integer"
          },
          "end_sura": {
            "title": "End Sura",
            "type": "integer"
          },
          "end_aya": {
            "title": "End Aya",
            "type": "integer"
          },
          "results": {
