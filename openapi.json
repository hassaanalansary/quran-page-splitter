          {
            "in": "path",
            "name": "mushaf_id",
            "schema": {
              "format": "uuid",
              "title": "Mushaf Id",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "tags": ["mushafs"]
      }
