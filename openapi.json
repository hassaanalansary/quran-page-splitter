          "start_aya",
          "end_sura",
          "end_aya",
          "results"
        ],
        "title": "ProcessOut",
        "type": "object"
      },
      "ProcessIn": {
        "properties": {
          "page_range_start": {
            "minimum": 1,
            "title": "Page Range Start",
            "type": "integer"
          },
          "page_range_end": {
            "minimum": 1,
            "title": "Page Range End",
            "type": "integer"
          },
          "start_sura": {
            "maximum": 114,
            "minimum": 1,
            "title": "Start Sura",
