                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "tags": ["mushafs"]
      },
      "post": {
        "operationId": "api_views_mushafs_create_mushaf",
        "summary": "Create Mushaf",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MushafCreateOut"
                }
              }
            }
          }
        },
        "tags": ["mushafs"],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "pdf": {
                    "format": "binary",
                    "title": "Pdf",
                    "type": "string"
                  },
                  "name": {
                    "title": "Name",
                    "type": "string"
                  },
                  "qiraa": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Qiraa"
                  },
                  "first_quran_pdf_page": {
                    "default": 1,
                    "title": "First Quran Pdf Page",
                    "type": "integer"
                  },
                  "last_quran_pdf_page": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Last Quran Pdf Page"
                  }
                },
                "required": ["pdf", "name"],
                "title": "MultiPartBodyParams",
                "type": "object"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/mushafs/{mushaf_id}": {
      "get": {
        "operationId": "api_views_mushafs_get_mushaf",
        "summary": "Get Mushaf",
        "parameters": [
          {
            "in": "path",
            "name": "mushaf_id",
            "schema": {
              "format": "uuid",
              "title": "Mushaf Id",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MushafOut"
                }
              }
            }
          }
        },
        "tags": ["mushafs"]
      },
      "delete": {
        "operationId": "api_views_mushafs_delete_mushaf",
