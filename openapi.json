          },
          "sura_header_threshold": {
            "default": 0.6,
            "maximum": 1,
            "minimum": 0,
            "title": "Sura Header Threshold",
            "type": "number"
          },
          "max_sura_headers": {
            "default": 3,
            "minimum": 1,
            "title": "Max Sura Headers",
            "type": "integer"
          },
          "match_threshold": {
            "default": 0.5,
            "maximum": 1,
            "minimum": 0,
            "title": "Match Threshold",
            "type": "number"
          },
          "alternate_horizontal_margin": {
            "default": false,
            "title": "Alternate Horizontal Margin",
            "type": "boolean"
          },
          "prefer_acceleration": {
            "default": true,
            "title": "Prefer Acceleration",
            "type": "boolean"
          }
        },
        "required": [
          "page_range_start",
          "page_range_end",
          "start_sura",
          "start_aya",
          "bounds"
        ],
        "title": "ProcessIn",
        "type": "object"
      },
