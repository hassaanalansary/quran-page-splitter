# Environment configuration template.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Generate a fresh SECRET_KEY with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

# --- Core ----------------------------------------------------------------
# SECRET_KEY has no fallback in settings.py: the app refuses to boot without it.
SECRET_KEY=change-me
# Set True for local development. With DEBUG=False the HTTPS hardening switches
# on, and http://localhost would redirect to https:// forever — if you need
# DEBUG=False locally, also set SECURE_SSL_REDIRECT=False below.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set False when a proxy terminates TLS and Django only ever sees plain HTTP.
# SECURE_SSL_REDIRECT=False
# Set True behind such a proxy, so Django knows the browser's request was HTTPS
# (X-Forwarded-Proto). Only behind a proxy that sets that header itself.
# TRUST_PROXY_SSL_HEADER=True

# --- Database ------------------------------------------------------------
# Omit for the local sqlite file (backend/db.sqlite3). Postgres in deployment —
# concurrent users plus a run committing a transaction per page will hit
# "database is locked" on sqlite.
# DATABASE_URL=postgres://user:password@localhost:5432/quran

# --- Jobs ----------------------------------------------------------------
# Who runs a processing job:
#   thread   a thread of the web process. No extra service. The default.
#   celery   a Celery worker. Needs Redis (CELERY_BROKER_URL) and a worker:
#              uv run celery -A config worker --concurrency 2
#            Docker sets this for you (.envs/.local/.django).
# JOB_RUNNER=thread
# CELERY_BROKER_URL=redis://localhost:6379/0
#
# The engines are CPU-bound OpenCV work, so more jobs at once does not mean more
# throughput: it means every job gets slower. A limit set to 0 is switched off.
#   JOB_WORKER_SLOTS          jobs running at once. With celery, a job over it
#                             waits in the queue. With thread, it is refused (429).
#                             Also the worker's --concurrency.
#   MAX_ACTIVE_JOBS_PER_USER  jobs one user may have queued or running (429).
#   MAX_QUEUED_JOBS           jobs that may wait for a slot (429, the queue is full).
# These replace MAX_CONCURRENT_JOBS and MAX_CONCURRENT_JOBS_PER_USER, which are no
# longer read.
# JOB_WORKER_SLOTS=2
# MAX_ACTIVE_JOBS_PER_USER=1
# MAX_QUEUED_JOBS=20
#
# Seconds a running job may go without reporting progress before another process
# may declare its worker dead and settle it as "interrupted". Must comfortably
# exceed your slowest single page.
# JOB_HEARTBEAT_TIMEOUT_SECONDS=300
# Seconds a queued job may wait, while a worker slot stands free, before it is
# settled as "interrupted": no worker picked it up. A job waiting behind running
# jobs is never affected.
# JOB_QUEUE_TIMEOUT_SECONDS=600

# --- Cache ---------------------------------------------------------------
# allauth counts its brute-force rate limits here (failed logins 5/5min per
# account + 10/min per IP, password resets 20/min per IP, signups 20/min per
# IP). The in-memory default is per-process, so set this whenever more than one
# worker process runs — otherwise every worker gets its own bucket and a
# restart clears the counts. `manage.py check --deploy` fails this as
# accounts.W001 if you forget.
#
# No Redis? django.core.cache.backends.db.DatabaseCache needs no extra service:
#   CACHE_URL=dbcache://cache_table   +   uv run python manage.py createcachetable
# CACHE_URL=redis://localhost:6379/1

# --- Cross-origin --------------------------------------------------------
# Leave both empty when the SPA is served same-origin by Django (production) or
# through the Vite dev proxy (development). Only needed if the frontend is
# hosted somewhere else. A wildcard is not an option — the API sends credentials.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com

# --- Email ---------------------------------------------------------------
# With EMAIL_HOST unset, Django prints emails to the console — signup
# verification and password-reset links appear in the runserver terminal, so
# both flows are fully testable in development without an SMTP account.
# Set EMAIL_HOST to switch to real SMTP; the other EMAIL_* values apply then.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Google sign-in ------------------------------------------------------
# From the Google Cloud Console (APIs & Services -> Credentials -> OAuth client
# ID, type "Web application"). Authorized redirect URI:
#   http://localhost:8000/_allauth/browser/v1/auth/provider/callback
# Left blank, the Google button is present but the round-trip will fail;
# email/password sign-in is unaffected.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Logs ----------------------------------------------------------------
# This process's own log file, under backend/logs. The Celery worker writes its
# own when it is given LOG_FILE=worker.log (Docker does that).
# LOG_FILE=quran.log
#
# --- Run logs ------------------------------------------------------------
# Detail level of the per-run log file each processing or word-detection run
# writes (and the in-app viewer tails). DEBUG is the whole trace, down to the
# evidence behind every blob of ink the word engine read — which is the level a
# single wrong cut can be diagnosed at, and the default.
# It costs roughly 17 KB per mushaf line, so a whole-sura word run is a few MB
# and al-Baqara around 17. Set INFO to keep every phase, verdict and reason and
# drop only the per-component detail.
# RUN_LOG_LEVEL=DEBUG
