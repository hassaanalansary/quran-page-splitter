# Environment configuration template.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Generate a fresh SECRET_KEY with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

# --- Core ----------------------------------------------------------------
# SECRET_KEY has no fallback in settings.py: the app refuses to boot without it.
SECRET_KEY=change-me
# Set True for local development. With DEBUG=False the HTTPS hardening switches
# on, and http://localhost would redirect to https:// forever — if you need
# DEBUG=False locally, also set SECURE_SSL_REDIRECT=False below.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set False when a proxy terminates TLS and Django only ever sees plain HTTP.
# SECURE_SSL_REDIRECT=False

# --- Database ------------------------------------------------------------
# Omit for the local sqlite file (backend/db.sqlite3). Postgres in deployment —
# concurrent users plus a run committing a transaction per page will hit
# "database is locked" on sqlite.
# DATABASE_URL=postgres://user:password@localhost:5432/quran

# --- Processing concurrency ----------------------------------------------
# Detection is CPU-bound OpenCV work, so more simultaneous runs does not mean
# more throughput — it means every run gets slower. A request over the limit is
# refused with 429 rather than queued.
# MAX_CONCURRENT_JOBS=2
# MAX_CONCURRENT_JOBS_PER_USER=1
# Seconds a run may go without reporting progress before another process may
# declare its worker dead and settle it as "interrupted". Must comfortably
# exceed your slowest single page.
# JOB_HEARTBEAT_TIMEOUT_SECONDS=300

# --- Cache ---------------------------------------------------------------
# allauth counts its brute-force rate limits here (failed logins 5/5min per
# account + 10/min per IP, password resets 20/min per IP, signups 20/min per
# IP). The in-memory default is per-process, so set this whenever more than one
# worker process runs — otherwise every worker gets its own bucket and a
# restart clears the counts. `manage.py check --deploy` fails this as
# accounts.W001 if you forget.
#
# No Redis? django.core.cache.backends.db.DatabaseCache needs no extra service:
#   CACHE_URL=dbcache://cache_table   +   uv run python manage.py createcachetable
# CACHE_URL=redis://localhost:6379/1

# --- Cross-origin --------------------------------------------------------
# Leave both empty when the SPA is served same-origin by Django (production) or
# through the Vite dev proxy (development). Only needed if the frontend is
# hosted somewhere else. A wildcard is not an option — the API sends credentials.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com

# --- Email ---------------------------------------------------------------
# With EMAIL_HOST unset, Django prints emails to the console — signup
# verification and password-reset links appear in the runserver terminal, so
# both flows are fully testable in development without an SMTP account.
# Set EMAIL_HOST to switch to real SMTP; the other EMAIL_* values apply then.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Google sign-in ------------------------------------------------------
# From the Google Cloud Console (APIs & Services -> Credentials -> OAuth client
# ID, type "Web application"). Authorized redirect URI:
#   http://localhost:8000/_allauth/browser/v1/auth/provider/callback
# Left blank, the Google button is present but the round-trip will fail;
# email/password sign-in is unaffected.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
