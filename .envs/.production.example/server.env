# What docker-compose.production.yml itself needs, before any container starts.
#
# A template: see the head of .django beside this file. Compose reads the copy in
# .envs/.production through COMPOSE_ENV_FILES (DEPLOY.md).

# The domain the site answers on, with no scheme. Its DNS record must already point
# at this server: Let's Encrypt checks it over port 80.
APP_DOMAIN=CHANGE-ME.example.com

# Where Let's Encrypt sends its notices about the certificate.
ACME_EMAIL=CHANGE-ME@example.com
